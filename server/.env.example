# ── LLM 供应商配置 ────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 成本路由的「强模型」档：仅困难任务才升档到它（cost 模式用）
OPENAI_STRONG_MODEL=gpt-4o
# 语义缓存用的 embedding 模型
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── 成本优化模式（cost）配置 ──────────────────────────────────
# 语义缓存后端。留空则回退进程内内存（demo 可直接跑）；
# 配置后使用 Redis（生产标准，跨实例共享 + 自动 TTL）。
REDIS_URL=
# 语义缓存命中阈值（余弦相似度 ≥ 此值才命中，越高越保守）
COST_CACHE_THRESHOLD=0.92
# 缓存 TTL（秒），默认 1 小时
COST_CACHE_TTL=3600

# ── 服务配置 ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── IP 守卫配置 ────────────────────────────────────────────────
# 60 秒内超过 30 次请求自动封锁
RATE_WINDOW_SEC=60
RATE_MAX_REQUESTS=30
# 是否自动封锁大陆 IP（true/false）
BLOCK_CN_IPS=true
# 封锁的国家代码，逗号分隔（默认 CN）
BLOCKED_COUNTRIES=CN
# 预置黑名单，逗号分隔
BLOCKED_IPS=
# 管理接口的 Bearer Token（留空则禁用管理接口）
ADMIN_TOKEN=your-admin-token-here

# ── MySQL 配置 ─────────────────────────────────────────────────
MYSQL_HOST=your-host.aivencloud.com
MYSQL_PORT=17304
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your-password-here
MYSQL_DB=defaultdb
# Aiven 等托管 MySQL 需要 SSL，设为 true；本地开发可留空
MYSQL_SSL=true
