# ── LLM 供应商配置 ────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── 服务配置 ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── IP 守卫配置 ────────────────────────────────────────────────
# 60 秒内超过 30 次请求自动封锁
RATE_WINDOW_SEC=60
RATE_MAX_REQUESTS=30
# 是否自动封锁大陆 IP（true/false）
BLOCK_CN_IPS=true
# 封锁的国家代码，逗号分隔（默认 CN）
BLOCKED_COUNTRIES=CN
# 预置黑名单，逗号分隔
BLOCKED_IPS=
# 管理接口的 Bearer Token（留空则禁用管理接口）
ADMIN_TOKEN=your-admin-token-here

# ── MySQL 配置 ─────────────────────────────────────────────────
MYSQL_HOST=your-host.aivencloud.com
MYSQL_PORT=17304
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your-password-here
MYSQL_DB=defaultdb
# Aiven 等托管 MySQL 需要 SSL，设为 true；本地开发可留空
MYSQL_SSL=true
